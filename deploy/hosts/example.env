# Per-host config for airo_agent. Copy to deploy/hosts/<ssh-alias>.env and edit;
# bin/deploy.sh installs it on that host as /etc/airo-agent.env (0640).
#
# The filename stem IS the SSH alias bin/deploy.sh connects to. Real host files
# carry a token and are gitignored — only this example is tracked.

# Release build target for this host. Optional — bin/deploy.sh otherwise probes
# `ssh <host> uname -m`. Set it to skip the probe or be explicit:
#   linux/amd64 (x86 boxes) | linux/arm64 (DGX Spark / aarch64).
# PLATFORM=linux/amd64

# This host's routable LAN address — what Airo (and its OpenAI client) reach the
# control API and the engines at. Setting a non-loopback value EXPOSES the
# control API + engines on 0.0.0.0. Leave unset for loopback-only dev.
AIRO_AGENT_ADVERTISE_HOST=192.168.68.50

# Serving slot ports (CSV), one resident model each. More slots = more models
# served at once. Size to the box's VRAM: single-GPU = one slot.
AIRO_AGENT_SLOTS=8081

# Stable id Airo keys this host's agent entity on (defaults to hostname).
AIRO_AGENT_HOST_ID=gpu-01

# Control API port.
AIRO_AGENT_PORT=4400

# Where to scan for local GGUF models (HF cache layout).
AIRO_AGENT_MODEL_ROOT=/home/airo-agent/.cache/huggingface/hub

# Optional bearer token for the control API + channel join. Independent of
# exposure. Keep secret — this is why real host files are gitignored.
AIRO_AGENT_TOKEN=

# Airo's /agent socket. Set it to push host state over the channel; unset =
# log-only (loopback dev).
AIRO_SOCKET_URL=ws://llm.local.joby.gg/agent

# Which engine adapters this host runs (CSV: llama_cpp,vllm). Default llama_cpp.
# AIRO_AGENT_ENGINES=llama_cpp

# --- llama.cpp host ---
# The engine binary + its shared libs on THIS host (provisioned out of band —
# the agent only spawns it, it does not install it).
LLAMA_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server
LLAMA_CPP_LIB=/opt/llama.cpp/build/bin

# --- vLLM host (e.g. a DGX Spark) — set AIRO_AGENT_ENGINES=vllm above ---
# Container image the vllm-slot wrapper runs (podman). arm64 on a Spark.
# Prereqs (host bootstrap): podman + nvidia-container-toolkit (CDI).
# VLLM_IMAGE=docker.io/vllm/vllm-openai:latest
# Override the bundled wrapper if needed:
# VLLM_SLOT_BIN=/opt/airo-agent/current/lib/airo_agent-0.1.0/priv/engine/vllm-slot
