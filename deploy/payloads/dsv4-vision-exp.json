{
  "model": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp:fp8",
  "profile": {
    "cmd_prefix": "/opt/dsv4/airo-entry.sh",
    "container_env": {
      "B12X_W4A16_TC_DECODE": "0",
      "CUTE_DSL_ARCH": "sm_121a",
      "DEFAULT_THINKING": "low",
      "DG_JIT_NVCC_COMPILER": "/usr/local/cuda/bin/nvcc",
      "DG_JIT_USE_NVRTC": "0",
      "DSPARK_MAX_INFLIGHT_PREFILLS": "1",
      "DSPARK_SUPPRESS_STOPS_IN_REASONING": "1",
      "FLASHINFER_CUDA_ARCH_LIST": "12.1a",
      "FLASHINFER_DISABLE_VERSION_CHECK": "1",
      "NCCL_CROSS_NIC": "1",
      "NCCL_CUMEM_ENABLE": "0",
      "NCCL_DEBUG": "WARN",
      "NCCL_IB_ADDR_FAMILY": "AF_INET",
      "NCCL_IB_DISABLE": "0",
      "NCCL_IB_ROCE_VERSION_NUM": "2",
      "NCCL_IGNORE_CPU_AFFINITY": "1",
      "NCCL_NET": "IB",
      "NCCL_NVLS_ENABLE": "0",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
      "TILELANG_CLEANUP_TEMP_FILES": "1",
      "TORCH_CUDA_ARCH_LIST": "12.1a",
      "TORCH_FR_BUFFER_SIZE": "2000",
      "TORCH_NCCL_DUMP_ON_TIMEOUT": "1",
      "TORCH_NCCL_ENABLE_MONITORING": "1",
      "TRANSFORMERS_OFFLINE": "1",
      "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
      "VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M": "16",
      "VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM": "0",
      "VLLM_ENGINE_READY_TIMEOUT_S": "3600",
      "VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS": "1800",
      "VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS": "0",
      "VLLM_NO_USAGE_STATS": "1",
      "VLLM_PREFIX_CACHE_RETENTION_INTERVAL": "4096",
      "VLLM_SPARSE_INDEXER_MAX_LOGITS_MB": "256",
      "VLLM_USE_B12X_MOE": "1",
      "VLLM_USE_BREAKABLE_CUDAGRAPH": "0",
      "VLLM_USE_FLASHINFER_SAMPLER": "1"
    },
    "ctx": 1048576,
    "dtype": "auto",
    "entrypoint": "bash",
    "extra_argv": [
      "--pipeline-parallel-size", "1",
      "--block-size", "256",
      "--max-num-batched-tokens", "8192",
      "--long-prefill-token-threshold", "1024",
      "--max-cudagraph-capture-size", "48",
      "--enable-prefix-caching",
      "--enable-prompt-tokens-details",
      "--async-scheduling",
      "--enable-chunked-prefill",
      "--speculative-config", "{\"method\":\"dspark\",\"num_speculative_tokens\":6,\"draft_sample_method\":\"probabilistic\"}",
      "--tokenizer-mode", "deepseek_v4",
      "--limit-mm-per-prompt", "{\"image\":8}",
      "--moe-backend", "flashinfer_b12x",
      "--tool-call-parser", "deepseek_v4",
      "--enable-auto-tool-choice",
      "--reasoning-parser", "deepseek_v4",
      "--reasoning-config", "{\"reasoning_parser\":\"deepseek_v4\",\"reasoning_start_str\":\"<think>\",\"reasoning_end_str\":\"</think>\"}",
      "--default-chat-template-kwargs", "{\"thinking\":true,\"reasoning_effort\":\"low\"}",
      "--generation-config", "vllm",
      "--enable-flashinfer-autotune"
    ],
    "gpu_memory_utilization": 0.835,
    "image": "ghcr.io/anemll/dspark-vllm-gx10:0.1.1",
    "kv_cache_dtype": "nvfp4_ds_mla",
    "nnodes": 2,
    "overlay_files": {
      "/home/jody/airo-agent-overlays/dsv4/airo-entry.sh": "/opt/dsv4/airo-entry.sh",
      "/home/jody/airo-agent-overlays/dsv4/patches": "/opt/dspark-patches"
    },
    "parallel": 6,
    "tensor_parallel_size": 2,
    "trust_remote_code": true
  },
  "slot": 8081
}
